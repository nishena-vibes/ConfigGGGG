#!/bin/bash

files=(*.{c,js,py})

if [ ${#files[@]} -eq 0 ]; then
    exit 1
fi

for file in "${files[@]}"; do
    read -r first_line < "$file" || continue

    case "${file##*.}" in
        c|js)
            regex='^[[:space:]]*(\/\/|\/\*)'
            ;;
        py)
            regex='^[[:space:]]*#'
            ;;
        *)
            continue
            ;;
    esac

    if [[ "$first_line" =~ $regex ]]; then
        echo "file '$file' contains comment: $first_line"
    fi
done
